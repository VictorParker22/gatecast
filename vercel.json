{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-data.cjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path((?!google[0-9a-f]+\\.html$|BingSiteAuth\\.xml$).*)",
      "has": [{ "type": "host", "value": "gatecast.vercel.app" }],
      "destination": "https://www.thegatecast.com/:path*",
      "permanent": true
    },

    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/library.html", "destination": "/library", "permanent": true },
    { "source": "/trip.html", "destination": "/trip", "permanent": true },
    { "source": "/flights.html", "destination": "/flights", "permanent": true },
    { "source": "/how.html", "destination": "/how", "permanent": true },

    { "source": "/stacks", "destination": "/stacks/", "permanent": true },
    { "source": "/stacks/:id([a-z0-9-]+)", "destination": "/stacks/:id/", "permanent": true },
    { "source": "/weekly", "destination": "/weekly/", "permanent": true },
    { "source": "/weekly/:week(\\d{4}-W\\d{2})", "destination": "/weekly/:week/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/library", "destination": "/library.html" },
    { "source": "/trip", "destination": "/trip.html" },
    { "source": "/flights", "destination": "/flights.html" },
    { "source": "/how", "destination": "/how.html" },
    { "source": "/weekly/", "destination": "/api/weird?view=weekly" },
    { "source": "/weekly/:week(\\d{4}-W\\d{2})/", "destination": "/api/weird?view=weekly&week=:week" },
    { "source": "/feed.xml", "destination": "/api/weird?view=feed" },
    { "source": "/weekly/feed.xml", "destination": "/api/weird?view=feed" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-2peZyC63SRTFW/laZouKk1TwfT7s7jreRE5mEOwPHuc=' 'sha256-5GeXECbY5/6BhCIrh25ObMgOxdsEs6GHpIkDi4/bS9c=' 'sha256-GLIzwyFX43MEKXs3/YR+LNh2zKJefriQ7vfSYPGn96g=' 'sha256-fIX6NKjYEkOQuicY6dEzHFk+I9LeGBu7Tr4S8fNUdT0=' 'sha256-tjPAX7c0KT0VMviDihC4anXo7edljvYVlz612y9eQIw=' https://platform.twitter.com https://cdn.syndication.twimg.com https://syndication.twitter.com https://www.google.com https://books.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' data: blob: https:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://buttondown.com; frame-ancestors 'self'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), payment=(), usb=(), midi=(), display-capture=(), geolocation=(self)" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/js/dist/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/data/books.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/weekly/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }]
    },
    {
      "source": "/feed.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }]
    },
    {
      "source": "/stacks/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "max-image-preview:large" }]
    },
    {
      "source": "/review.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
