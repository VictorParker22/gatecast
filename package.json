{
  "name": "gatecast",
  "version": "1.0.0",
  "private": true,
  "description": "Checks whether the weather will disrupt your flights and connections, with a plain-language verdict for every airport on the trip.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorParker22/gatecast.git"
  },
  "homepage": "https://github.com/VictorParker22/gatecast#readme",
  "bugs": {
    "url": "https://github.com/VictorParker22/gatecast/issues"
  },
  "scripts": {
    "build": "node scripts/build-data.cjs",
    "start": "node server.js",
    "dev": "node scripts/dev.cjs",
    "test": "node --test tests/*.mjs tests/*.cjs",
    "ci": "npm test && npm run build",
    "css": "node scripts/build-css.cjs"
  },
  "dependencies": {
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "daisyui": "5.8.1",
    "tailwindcss": "4.3.5"
  }
}
