{
  "name": "gatecast",
  "version": "1.0.0",
  "private": true,
  "description": "Weird news from real outlets, each linked to the original, with the local weather told plainly, The Stacks (a library of strange true stories and classic fiction) and quick weather checks for flights.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorParker22/gatecast.git"
  },
  "homepage": "https://github.com/VictorParker22/gatecast#readme",
  "bugs": {
    "url": "https://github.com/VictorParker22/gatecast/issues"
  },
  "scripts": {
    "build": "node scripts/build-data.cjs",
    "start": "node server.js",
    "dev": "node scripts/dev.cjs",
    "test": "node --test tests/*.mjs tests/*.cjs",
    "ci": "npm test && npm run build",
    "css": "node scripts/build-css.cjs"
  },
  "dependencies": {
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "daisyui": "5.8.1",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5"
  }
}
